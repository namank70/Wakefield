NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_GUIDED_MODE=true
NEXT_PUBLIC_API_BASE_URL=

# Local image AI, used independently of browser-local report storage.
ANALYSIS_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_TIMEOUT_MS=180000

# Server-only EAiSER configuration. Never commit real values.
EAISER_API_URL=
EAISER_API_KEY=
EAISER_IMAGE_FIELD=image
EAISER_CONTEXT_FIELD=context
EAISER_MAX_IMAGE_BYTES=10485760

# Optional provider/database overrides for a separately configured live integration.
# EAISER_API_URL=https://your-eaiser-provider.example/analyze
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
